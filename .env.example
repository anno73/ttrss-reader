# Copy to .env locally. Never commit real credentials.
# Values are literal: no variable expansion, escape processing, or inline comments.
# Optional matching outer quotes are removed; whitespace inside quotes is preserved.
TTRSS_PERSONAL_USERNAME=replace-with-username
TTRSS_PERSONAL_PASSWORD="replace-with-password"
TTRSS_TEST_USERNAME=replace-with-test-username
TTRSS_TEST_PASSWORD="replace-with-test-password"
